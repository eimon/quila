# =============================================================================
# Quila — Production Environment Variables
# Copy this file to .env and fill in the values before deploying.
# Used by docker-compose.prod.yml
# =============================================================================

# -----------------------------------------------------------------------------
# Security
# Must be a long, random string. Used for JWT signing (API) and
# JWT verification (Next.js frontend). Both services must share the same value.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=

# JWT algorithm (default: HS256, no need to change unless you know why)
# ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Database
# Password for the postgres user. Used by both the API (DATABASE_URL) and
# the db service (POSTGRES_PASSWORD).
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Hostnames (for reverse proxy / Let's Encrypt)
# API_HOST: public domain for the FastAPI service  (e.g. api.example.com)
# HOST:     public domain for the Next.js frontend (e.g. example.com)
# -----------------------------------------------------------------------------
API_HOST=api.example.com
HOST=example.com

# -----------------------------------------------------------------------------
# Chatbot integration (chatv2)
# BOT_API_KEY: shared secret the chatbot sends as "Authorization: Bearer <key>"
#              on /bot/* requests. Leave empty to disable the bot endpoints.
#              Generate with: openssl rand -hex 32
# HOLD_TTL_HOURS: hours a chatbot hold blocks the dates before it expires.
# BUSINESS_TIMEZONE: IANA zone that defines the business "today" (bot check-in
#              validation, catalog prices). Default America/Argentina/Buenos_Aires.
# -----------------------------------------------------------------------------
BOT_API_KEY=
HOLD_TTL_HOURS=24
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
